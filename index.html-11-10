<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Sistema de Escala BK</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'%3E%3Crect fill='%23FFEED8' width='200' height='200' rx='30'/%3E%3Cellipse cx='100' cy='55' rx='75' ry='35' fill='%23FF7B00'/%3E%3Cellipse cx='100' cy='145' rx='75' ry='35' fill='%23FF7B00'/%3E%3Ctext x='100' y='115' font-size='70' font-weight='bold' text-anchor='middle' fill='%23D62300' font-family='Arial'%3EBK%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
<style>
:root{--laranja:#FF7B00;--vermelho:#D62300;--escuro:#1F1F1F;--pagina:linear-gradient(135deg,#ff7b00,#d62300);--card:#fff;--form:#FFF4E8;--texto:#333;--borda:#FFC8B0}
body.escuro{--pagina:linear-gradient(135deg,#1a1a2e,#16213e);--card:#1f2937;--form:#374151;--texto:#e5e7eb;--borda:#4b5563}
*{box-sizing:border-box;margin:0;padding:0;font-family:Poppins,sans-serif}
html,body{width:100%;min-height:100vh;overflow-x:hidden}
body{background:var(--pagina);color:var(--texto)}
button{background:linear-gradient(90deg,#D62300,#B61C00);color:#fff;border:0;padding:10px 18px;border-radius:10px;cursor:pointer;font-weight:600;margin:8px 8px 0 0;box-shadow:0 4px 12px #d623004d}
button:hover{transform:translateY(-1px)}
/* Melhorias de uso no celular */
.btn-editar-principal{display:none}
.celula-editavel select,.celula-editavel input{min-width:125px;min-height:42px;font-size:14px;padding:8px;border:2px solid #ff7b00;border-radius:9px;background:var(--card);color:var(--texto)}
.dia-destaque{display:inline-block;background:#ff7b00;color:#171717;padding:4px 9px;border-radius:8px;font-weight:800}
.menu-mobile{display:none}button.sucesso{background:linear-gradient(90deg,#10b981,#059669)}button.azul{background:linear-gradient(90deg,#3b82f6,#2563eb)}button.vermelho{background:linear-gradient(90deg,#ef4444,#dc2626);padding:5px 8px;font-size:12px;margin:0}
aside{width:220px;background:linear-gradient(180deg,#1f1f1f,#2a2a2a);color:#fff;padding:20px 15px;position:fixed;top:0;left:0;height:100vh;overflow-y:auto;z-index:100;box-shadow:4px 0 20px #0004;transition:.35s}
aside.minimizado{width:70px;padding:15px 8px}aside.minimizado .logo span,aside.minimizado .logo p,aside.minimizado .menu a span{display:none}aside.minimizado .menu a{justify-content:center;padding:14px 0;font-size:20px}
.btn-toggle{width:100%;padding:10px;margin-bottom:10px;border-radius:12px;background:linear-gradient(90deg,#FF7B00,#FF8C00);color:#000;font-size:20px}
.btn-tema{background:#374151;color:#fff;font-size:14px;padding:8px}
.logo{text-align:center;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid #ff7b004d}.logo h1{font-size:20px}.logo p{font-size:12px;color:#ff7b00;margin-top:6px}
.status-sinc{font-size:12px;padding:6px 10px;border-radius:8px;margin:10px 0;text-align:center}.conectado{background:#d1fae5;color:#065f46}.desconectado{background:#fee2e2;color:#991b1b}
.menu a{display:flex;align-items:center;gap:10px;color:#fff;text-decoration:none;padding:14px 12px;margin-bottom:8px;border-radius:12px;font-weight:600;cursor:pointer;font-size:14px}.menu a:hover{background:#ff7b0033;border-color:#ff7b00}.menu a.ativo{background:linear-gradient(90deg,#D62300,#B61C00)}
main{width:calc(100% - 220px);min-height:100vh;padding:30px 35px;margin-left:220px;transition:.35s}main.expandido{width:calc(100% - 70px);margin-left:70px}
.pagina{display:none;animation:aparecer .4s}.pagina.ativa{display:block}@keyframes aparecer{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:none}}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:15px}header h2{color:#fff;font-size:26px;text-shadow:0 2px 8px #0003}header p{color:#fffe;font-weight:500;margin-top:4px}.relogio{background:#fff;padding:12px 20px;border-radius:14px;font-weight:700;color:#D62300;box-shadow:0 8px 24px #d6230040;border:3px solid #FF7B00}
.tabela,.caixa-form{background:var(--card);border-radius:16px;padding:28px;box-shadow:0 8px 24px #d6230040;margin-bottom:28px;overflow:auto;border-top:5px solid #D62300;color:var(--texto)}.tabela h2,.caixa-form h2{color:#D62300;margin-bottom:20px;font-size:20px}
table{width:100%;border-collapse:separate;border-spacing:0;border-radius:12px;overflow:hidden}th{background:linear-gradient(90deg,#D62300,#B61C00);color:#fff;padding:14px 10px;font-size:14px}td{padding:12px 10px;text-align:center;border-bottom:1px solid #FFE4D6;font-size:14px}tr:nth-child(even) td{background:#FFF8F2}tr:hover td{background:#FFE4D6}
.linha-form{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:15px;align-items:center}.linha-form label{font-weight:600;color:#B61C00;min-width:110px}.linha-form input,.linha-form select,.linha-form textarea{padding:10px 14px;border:2px solid var(--borda);border-radius:10px;font-size:15px;flex:1;min-width:180px;background:transparent;color:var(--texto)}.linha-form textarea{min-height:90px;resize:vertical}
.aviso-importante{background:linear-gradient(135deg,#fff7f2,#fff,#ffe9df);border:3px solid #D62300;border-left:9px solid #D62300;border-radius:22px;padding:28px 32px;margin-bottom:30px;box-shadow:0 12px 32px #d6230033;position:relative}.aviso-conteudo{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.aviso-icone{width:75px;height:75px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#D62300;color:#fff;font-size:38px}.aviso-texto{flex:1;min-width:250px}.aviso-titulo{font-size:27px;color:#D62300;margin-bottom:8px}.aviso-mensagem{font-size:16px;line-height:1.6;font-weight:600}.aviso-meta{display:flex;gap:10px;margin-top:12px}.aviso-tag{padding:7px 12px;border-radius:20px;font-size:12px;font-weight:700}.aviso-data{background:#ffe4e4;color:#991b1b}.aviso-prioridade{background:#D62300;color:#fff}.aviso-editar{position:absolute;top:18px;right:18px;background:#fff;color:#D62300;border:2px solid #D62300;padding:7px 12px;font-size:12px}.aviso-form-container{display:none;margin-top:20px;padding-top:15px;border-top:2px dashed #ffcccc}.aviso-form-container.visivel{display:block}.aviso-form-container textarea{width:100%;min-height:100px;padding:12px;border:2px solid #ffcccc;border-radius:10px;background:transparent;color:var(--texto)}
.desperdicio-info,.aviso-diario,.aviso-sinc{padding:12px 15px;border-radius:10px;margin-bottom:16px;font-size:13px;font-weight:600}.desperdicio-info{background:#fff7ed;border:1px solid #ffd7bd;color:#9a3412}.aviso-diario{background:#fff3cd;border-left:5px solid #ffc107;color:#856404}.aviso-sinc{background:#dbeafe;border-left:5px solid #3b82f6;color:#1e40af}
.grupo-turno{background:var(--form);border-radius:12px;padding:20px;margin-bottom:20px}.grupo-turno h3{color:#D62300;margin-bottom:15px}.tag-turno-manha,.tag-turno-noite{display:inline-block;padding:3px 10px;border-radius:20px;font-size:13px}.tag-turno-manha{background:#fbbf24;color:#78350f}.tag-turno-noite{background:#3b82f6;color:#fff}
.celula-editavel input{width:100%;border:2px solid #ff7b00;border-radius:6px;padding:6px;text-align:center;background:var(--card);color:var(--texto)}
.editar-discreto{display:flex;justify-content:flex-end;margin:-8px 0 10px}.btn-editar-discreto{width:32px;height:32px;padding:0;margin:0;background:transparent;color:#999;border:1px solid #9996;box-shadow:none;opacity:.55;border-radius:50%}.btn-editar-discreto:hover{opacity:1;background:#ff7b0015;color:#D62300}
.painel-edicao-discreto{display:none;align-items:center;gap:7px;flex-wrap:wrap;padding:8px;margin-bottom:10px;background:var(--form);border:1px solid var(--borda);border-radius:10px}.painel-edicao-discreto.visivel{display:flex}.painel-edicao-discreto input{width:130px;padding:7px;border:1px solid #ccc;border-radius:7px;background:var(--card);color:var(--texto)}.painel-edicao-discreto button{margin:0;padding:7px 10px;font-size:12px}.status-edicao{padding:4px 10px;border-radius:20px;font-size:12px;font-weight:600}.status-edicao.liberado{background:#d1fae5;color:#065f46}.status-edicao.bloqueado{background:#fee2e2;color:#991b1b}
.controle-qtd{display:flex;align-items:center;justify-content:center;gap:7px}.btn-qtd{width:34px;height:34px;padding:0;margin:0;border-radius:9px;font-size:20px;display:inline-flex;align-items:center;justify-content:center}.btn-qtd.menos{background:#ef4444}.btn-qtd.mais{background:#10b981}.qtd-valor{font-size:17px;font-weight:800;color:#D62300}.produto-registro{text-align:left!important;font-weight:700}
#resumo{background:var(--form);padding:12px 15px;border-radius:10px;font-size:14px;font-weight:600}
#caixaResultado{margin-top:20px;padding:20px;background:var(--form);border-radius:12px;display:none}

/* Escalas em formato de lista dinâmica, com o dia no centro */
.escala-topo{position:relative;text-align:center;padding:22px 16px 18px;margin:0 auto 18px;max-width:620px;border-radius:18px;background:linear-gradient(135deg,#fff5ec,#fff);border:1px solid #ffd1b9;box-shadow:0 8px 22px #d6230018;color:#252525}
body.escuro .escala-topo{background:linear-gradient(135deg,#273449,#1f2937);border-color:#475569;color:#f3f4f6}
.escala-topo .dia-label{font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:700;color:#d62300}
body.escuro .escala-topo .dia-label{color:#ff9a45}
.escala-topo h3{font-size:clamp(23px,4vw,32px);font-weight:800;margin:5px 0 2px;color:#d62300}
body.escuro .escala-topo h3{color:#ff8a35}
.escala-topo .data-label{font-size:13px;opacity:.75}
.escala-topo .folga-hoje{display:inline-flex;gap:6px;align-items:center;margin-top:11px;padding:6px 12px;border-radius:99px;background:#ffe3d4;color:#9b2508;font-size:12px;font-weight:700}
.escala-lista{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.escala-item{display:flex;align-items:center;gap:14px;padding:14px 16px;border:1px solid #e7e7e7;border-left:4px solid #ff7b00;border-radius:13px;background:#fff;box-shadow:0 4px 12px #00000008;transition:transform .18s,box-shadow .18s;color:#242424}
.escala-item:hover{transform:translateY(-2px);box-shadow:0 7px 18px #d6230018}
body.escuro .escala-item{background:#273244;border-color:#3b4658;color:#f3f4f6}
.escala-avatar{width:42px;height:42px;flex:0 0 42px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:#fff0e4;color:#b52a08;font-size:16px;font-weight:800}
body.escuro .escala-avatar{background:#49362e;color:#ffb27b}
.escala-pessoa{flex:1;min-width:0;font-weight:700;font-size:14px}
.escala-tarefa{display:inline-flex;align-items:center;justify-content:flex-end;text-align:right;max-width:62%;padding:7px 11px;border-radius:9px;background:#fff1e8;color:#9f2a0d;font-size:13px;font-weight:700;line-height:1.35}
body.escuro .escala-tarefa{background:#3b3440;color:#ffc29d}
.escala-tarefa.folga{background:#e4f8ed;color:#087443}
body.escuro .escala-tarefa.folga{background:#164634;color:#a7f3d0}
.escala-item select,.escala-item input{width:100%;max-width:260px;min-width:0;min-height:42px;padding:8px;border:1px solid #ff9a45;border-radius:9px;background:var(--card);color:var(--texto);font-size:13px}
.escala-editar-linha{display:flex;justify-content:flex-end;margin:-12px 0 8px}
.escala-editar-btn{width:30px;height:30px;border-radius:50%;padding:0;margin:0;background:transparent;border:1px solid #9995;color:#8b8b8b;box-shadow:none;font-size:14px;opacity:.65}
.escala-editar-btn:hover{opacity:1;background:#ff7b0015;color:#d62300}
.escala-folga-edit{max-width:760px;margin:0 auto 12px;padding:10px 13px;border-radius:10px;background:var(--form);font-size:13px}
@media(max-width:768px){.escala-topo{padding:20px 12px;margin-bottom:14px}.escala-item{padding:12px;gap:10px}.escala-avatar{width:38px;height:38px;flex-basis:38px}.escala-pessoa{font-size:13px}.escala-tarefa{font-size:12px;max-width:58%;padding:7px 8px}.escala-item select,.escala-item input{max-width:58%;font-size:12px}.escala-editar-linha{margin-top:-7px}}
@media(max-width:768px){aside,aside.minimizado{position:relative;width:100%;height:auto;padding:12px}.menu a{display:flex;padding:11px 12px;margin-bottom:5px}.menu-mobile{display:block;width:100%;margin:4px 0 10px;padding:12px;font-size:16px}.menu.fechado a{display:none}aside .logo{margin-bottom:10px}main,main.expandido{width:100%;margin:0;padding:20px}table{min-width:650px}.aviso-conteudo{flex-direction:column;align-items:stretch}.aviso-editar{position:static;width:100%;margin-bottom:10px}.linha-form{flex-direction:column;align-items:stretch}.linha-form input,.linha-form select,.linha-form textarea{width:100%}}
@media print{aside,button,.editar-discreto,.painel-edicao-discreto,.aviso-editar,.relogio{display:none!important}main{width:100%;margin:0;padding:10px}body{background:#fff}.tabela{box-shadow:none}}
</style>
</head>
<body>
<aside id="sidebar">
<button class="btn-toggle menu-mobile" onclick="alternarMenuCelular()">☰ Abrir menu</button><button class="btn-toggle" onclick="toggleMenu()">◀ Recolher menu</button>
<button class="btn-toggle btn-tema" onclick="alternarTema()">🌙 Tema</button>
<div class="logo"><h1>🍔 <span>BK Escala</span></h1><p>Sistema de Escala Oficial</p></div>
<div class="status-sinc conectado" id="statusSinc">✅ Sincronizado em tempo real</div>
<nav class="menu">
<a class="ativo" onclick="mostrarPagina('fechamento',this)">📋 <span>Escala de Fechamento</span></a>
<a onclick="mostrarPagina('pre-fechamento',this)">🔧 <span>Escala de Pré-Fechamento</span></a>
<a onclick="mostrarPagina('validade',this)">📅 <span>Validade</span></a>
<a onclick="mostrarPagina('desperdicio',this)">📉 <span>Desperdício</span></a>
<a onclick="mostrarPagina('breaks',this)">🍔 <span>Controle de Breaks</span></a>
<a onclick="mostrarPagina('utilidades',this)">🛠️ <span>Utilidades</span></a>
<a onclick="mostrarPagina('qrcode',this)">📱 <span>Acesso Rápido</span></a>
</nav>
</aside>

<main id="conteudo">
<div id="pag-fechamento" class="pagina ativa">
<header><div><h2>📋 Escala de Fechamento</h2><p>Escala de hoje</p></div><div class="relogio"></div></header>
<div class="aviso-importante">
<button class="aviso-editar" onclick="alternarFormAviso()">✏️ EDITAR</button>
<div class="aviso-conteudo"><div class="aviso-icone">🔔</div><div class="aviso-texto"><h3 class="aviso-titulo">AVISO IMPORTANTE</h3><p class="aviso-mensagem" id="textoAviso">Hoje o fechamento será realizado às 02:30.<br>Todos devem conferir suas funções antes de iniciar o turno.</p><div class="aviso-meta"><span class="aviso-tag aviso-data">📅 Hoje</span><span class="aviso-tag aviso-prioridade">⚠️ PRIORIDADE ALTA</span></div></div></div>
<div class="aviso-form-container" id="formAvisoContainer"><textarea id="novoTextoAviso">Hoje o fechamento será realizado às 02:30.
Todos devem conferir suas funções antes de iniciar o turno.</textarea><button class="sucesso" onclick="salvarAviso()">💾 Salvar Aviso</button><button onclick="limparAviso()">🗑️ Limpar Aviso</button></div>
</div>
<div class="tabela">
<h2>Escala de Fechamento — Hoje</h2>
<div class="escala-editar-linha"><button class="escala-editar-btn" title="Opções de edição" aria-label="Abrir edição da escala" onclick="abrirEdicaoFech()">⚙</button></div>
<div class="painel-edicao-discreto" id="painelEdicaoFech">
<input type="password" id="senhaFech" placeholder="Senha">
<button class="azul" onclick="liberarEdicaoFech()">Entrar</button>
<span class="status-edicao bloqueado" id="statusEditFechado">🔒 Bloqueado</span>
<div id="botoesSalvarFech" style="display:none"><button class="sucesso" onclick="salvarEscalaFechamento()">💾 Salvar</button><button onclick="recarregarEscalaFech()">🔄 Restaurar</button><button class="azul" onclick="adicionarFuncionarioFech()">➕ Funcionário</button><button onclick="bloquearEdicaoFech()">🔒 Bloquear</button></div>
</div>
<div id="corpoFechamento" class="escala-render"></div>
<p style="margin-top:12px;font-size:13px;color:#777">📌 A escala mostra somente o dia atual. A edição fica escondida no ⚙️.</p>
<button onclick="window.print()">🖨 Imprimir</button>
</div>
</div>

<div id="pag-pre-fechamento" class="pagina">
<header><div><h2>🔧 Escala de Pré-Fechamento</h2><p>Escala de hoje</p></div><div class="relogio"></div></header>
<div class="aviso-importante">
<button class="aviso-editar" onclick="alternarFormAvisoPre()">✏️ EDITAR</button>
<div class="aviso-conteudo"><div class="aviso-icone">🔔</div><div class="aviso-texto"><h3 class="aviso-titulo">AVISO IMPORTANTE</h3><p class="aviso-mensagem" id="textoAvisoPre">Confira os materiais e equipamentos antes de iniciar os procedimentos de pré-fechamento.</p><div class="aviso-meta"><span class="aviso-tag aviso-data">📅 Hoje</span><span class="aviso-tag aviso-prioridade">⚠️ ATENÇÃO</span></div></div></div>
<div class="aviso-form-container" id="formAvisoContainerPre"><textarea id="novoTextoAvisoPre"></textarea><button class="sucesso" onclick="salvarAvisoPre()">💾 Salvar Aviso</button></div>
</div>
<div class="tabela">
<h2>Escala de Pré-Fechamento — Hoje</h2>
<div class="escala-editar-linha"><button class="escala-editar-btn" title="Opções de edição" aria-label="Abrir edição da escala" onclick="abrirEdicaoPre()">⚙</button></div>
<div class="painel-edicao-discreto" id="painelEdicaoPre">
<input type="password" id="senhaPre" placeholder="Senha">
<button class="azul" onclick="liberarEdicaoPre()">Entrar</button>
<span class="status-edicao bloqueado" id="statusEditPre">🔒 Bloqueado</span>
<div id="botoesSalvarPre" style="display:none"><button class="sucesso" onclick="salvarEscalaPre()">💾 Salvar</button><button onclick="recarregarEscalaPre()">🔄 Restaurar</button><button class="azul" onclick="adicionarFuncionarioPre()">➕ Funcionário</button><button onclick="bloquearEdicaoPre()">🔒 Bloquear</button></div>
</div>
<div id="corpoPre" class="escala-render"></div>
<p style="margin-top:12px;font-size:13px;color:#777">📌 A escala mostra somente o dia atual. A edição fica escondida no ⚙️.</p>
<button onclick="window.print()">🖨 Imprimir</button>
</div>
</div>

<div id="pag-validade" class="pagina">
<header><div><h2>📅 Controle de Validade</h2><p>Validades padrão e calculadora</p></div><div class="relogio"></div></header>
<div class="tabela"><h2>📋 Validades Padrão</h2><table><tr><th>Produto</th><th>Validade</th></tr><tr><td>Maionese</td><td>7 dias</td></tr><tr><td>Molho Stacker</td><td>3 dias</td></tr><tr><td>Barbecue</td><td>7 dias</td></tr><tr><td>Cheddar</td><td>5 dias</td></tr><tr><td>Picles</td><td>7 dias</td></tr><tr><td>Pimenta</td><td>7 dias</td></tr><tr><td>Queijo</td><td>4 dias</td></tr></table></div>
<div class="caixa-form"><h2>🔍 Calcular Validade</h2><div class="linha-form"><label>Data Fabricação:</label><input type="date" id="dataFab"></div><div class="linha-form"><label>Validade:</label><select id="tipoValidade"><option value="dias">Dias</option><option value="meses">Meses</option></select></div><div class="linha-form"><label>Quantidade:</label><input type="number" id="quantidade" min="1"></div><button onclick="calcularValidade()">🧮 Calcular</button><button onclick="usarHoje()">📍 Hoje</button><div id="caixaResultado"><h3>✅ Válido até: <span id="dtValidade"></span></h3></div></div>
</div>

<div id="pag-desperdicio" class="pagina">
<header><div><h2>📉 Controle de Desperdício</h2><p>Unidades e gramaturas separadas</p></div><div class="relogio"></div></header>
<div class="aviso-diario">⚠️ Registros válidos até às <strong>03:00 do dia seguinte</strong>.</div>
<div class="aviso-sinc">✅ Sincronização em tempo real ativa. Unidades e gramas nunca são misturados.</div>
<div class="caixa-form"><h2>➕ Adicionar Desperdício</h2><div class="desperdicio-info">💡 O mesmo produto pode aparecer separado em <strong>unidades</strong> e <strong>gramas</strong>. Cada tipo possui seu próprio total.</div>
<div class="linha-form"><label>Produto:</label><select id="produto" onchange="verificarOutro()"><option value="">Selecione...</option><option>Pão de Hambúrguer</option><option>Pão de Whopper</option><option>Carne de Hambúrguer</option><option>Carne de Whopper</option><option>Chicken</option><option>Crispy</option><option>Pão Supremo</option><option>Pão de Brioche</option><option value="outros">Outros ▾</option></select></div>
<div class="linha-form" id="campoOutroProduto" style="display:none"><label>Digite o item:</label><input id="produtoOutro" placeholder="Ex: Bacon, molho, sobremesa..."></div>
<div class="linha-form"><label>Tipo:</label><select id="unidadeDesperdicio" onchange="atualizarCampoQuantidade()"><option value="un">Unidade (un)</option><option value="g">Gramatura (g)</option></select></div>
<div class="linha-form"><label id="labelQuantidade">Quantidade (un):</label><input type="number" id="qtdDesperdicio" min="1" step="1" placeholder="Ex: 5"></div>
<button class="sucesso" onclick="adicionarDesperdicio()">✅ Adicionar</button><button class="vermelho" onclick="limparDesperdicios()">🗑️ Zerar</button></div>
<div class="tabela"><h2>📋 Registros</h2><table><thead><tr><th>Última atualização</th><th>Produto</th><th>Quantidade</th><th>Controle</th><th>Excluir</th></tr></thead><tbody id="corpoDesp"></tbody></table><p id="resumo" style="margin-top:15px"><strong>Totais:</strong> 0 unidades</p></div>
</div>

<div id="pag-breaks" class="pagina">
<header><div><h2>🍔 Controle de Breaks</h2><p>Refeições dos funcionários</p></div><div class="relogio"></div></header>
<div class="aviso-diario">⚠️ Registros expiram às <strong>03:00 do dia seguinte</strong>.</div>
<div class="caixa-form"><h2>📋 Dados do Dia</h2><div class="linha-form"><label>Data:</label><input type="date" id="dataBreak"></div><div class="linha-form"><label>Gerente:</label><input id="gerenteTurno" placeholder="Nome do gerente"></div></div>
<div class="grupo-turno"><h3>☀️ Turno da Manhã</h3><div class="linha-form"><label>Funcionário:</label><input id="nomeFuncManha" placeholder="Nome"></div><div class="linha-form"><label>Itens:</label><textarea id="itensManha" placeholder="Digite tudo que consumiu"></textarea></div><button class="sucesso" onclick="adicionarBreak('manha')">✅ Registrar Break Manhã</button></div>
<div class="grupo-turno"><h3>🌙 Turno da Noite</h3><div class="linha-form"><label>Funcionário:</label><input id="nomeFuncNoite" placeholder="Nome"></div><div class="linha-form"><label>Itens:</label><textarea id="itensNoite" placeholder="Digite tudo que consumiu"></textarea></div><button class="sucesso" onclick="adicionarBreak('noite')">✅ Registrar Break Noite</button></div>
<div class="tabela"><h2>📋 Registros de Breaks</h2><table><thead><tr><th>Turno</th><th>Funcionário</th><th>Itens</th><th>Gerente</th><th>Horário</th><th>Excluir</th></tr></thead><tbody id="corpoBreaks"></tbody></table><p id="resumoBreaks" style="margin-top:15px"><strong>Total:</strong> 0 registros</p><button class="vermelho" onclick="limparBreaks()">🗑️ Zerar Tudo</button></div>
</div>

<div id="pag-utilidades" class="pagina">
<header><div><h2>🛠️ Utilidades</h2><p>Ferramentas práticas</p></div><div class="relogio"></div></header>
<div class="caixa-form"><h2>🌴 Dias até a Folga</h2><div class="linha-form"><label>Funcionário:</label><select id="funcionario" onchange="calcularFolga()"><option value="">Selecione</option><option value="1">Dandara (Segunda)</option><option value="2">Luísa (Terça)</option><option value="3">Gabriel (Quarta)</option><option value="4">Amanda (Quinta)</option><option value="5">Julyan (Sexta)</option></select></div><div id="resFolga" style="margin-top:15px;padding:15px;background:var(--form);border-radius:12px;display:none"><p id="textoFolga"></p></div></div>
</div>

<div id="pag-qrcode" class="pagina">
<header><div><h2>📱 Acesso Rápido</h2><p>Escaneie para abrir</p></div><div class="relogio"></div></header>
<div class="tabela" style="text-align:center"><h2>📱 QR Code</h2><img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=https://burguerking723.github.io/Escala18069/" alt="QR Code" width="250" height="250"><p style="margin-top:15px">https://burguerking723.github.io/Escala18069/</p></div>
</div>
</main>

<script>
const firebaseConfig={apiKey:"AIzaSyCPfk6RUVWYZ8vQ80j-HSPrIK42yzwIA-Nk",authDomain:"bk-escala.firebaseapp.com",databaseURL:"https://bk-escala-default-rtdb.firebaseio.com",projectId:"bk-escala",storageBucket:"bk-escala.firebasestorage.app",messagingSenderId:"191531981744",appId:"1:191531981744:web:9f87cc5ae24bfa1e3c31475"};
firebase.initializeApp(firebaseConfig);
const db=firebase.database();
const DESPERDICIO_REF=db.ref("desperdicio"),BREAKS_REF=db.ref("breaks"),ESCALA_FECHAMENTO_REF=db.ref("escala_fechamento"),ESCALA_PRE_REF=db.ref("escala_pre_fechamento"),EQUIPE_FECHAMENTO_REF=db.ref("equipe_fechamento"),EQUIPE_PRE_REF=db.ref("equipe_pre_fechamento"),AVISO_REF=db.ref("aviso_geral"),AVISO_PRE_REF=db.ref("aviso_pre_fechamento");
const SENHA_EDICAO="292722";
let podeEditarFechamento=false,podeEditarPre=false,escalaFechamentoAtual=[],escalaPreAtual=[];
let funcionariosFechamento=["Daniel","Mariana","Julyan","Thuanney"],funcionariosPre=["Gabriel","Amanda","Dandara","Luísa","Júlia"];
const diasSemana=["Domingo","Segunda-feira","Terça-feira","Quarta-feira","Quinta-feira","Sexta-feira","Sábado"];
const ESCALA_FECHAMENTO_PADRAO=[
{folga:"Julyan",Daniel:"Broiler",Mariana:"Coifa",Julyan:"— FOLGA —",Thuanney:"Louça + Mesa"},
{folga:"Thuanney",Daniel:"Mesa + Broiler",Mariana:"Louça",Julyan:"Coifa",Thuanney:"— FOLGA —"},
{folga:"Daniel",Daniel:"— FOLGA —",Mariana:"Broiler",Julyan:"Mesa + Coifa",Thuanney:"Louça"},
{folga:"Mariana",Daniel:"Coifa",Mariana:"— FOLGA —",Julyan:"Broiler + Mesa",Thuanney:"Louça"},
{folga:"—",Daniel:"Broiler",Mariana:"Coifa",Julyan:"Louça",Thuanney:"Mesa"},
{folga:"—",Daniel:"Coifa",Mariana:"Broiler",Julyan:"Mesa",Thuanney:"Louça"},
{folga:"—",Daniel:"Louça + Mesa",Mariana:"Broiler",Julyan:"Coifa",Thuanney:"Mesa"}];
const ESCALA_PRE_PADRAO=[
{Gabriel:"Freezer",Amanda:"Batateira",Dandara:"Folga",Luísa:"Freezer Frango",Júlia:"Freezer Carne ■ Lixeiras"},
{Gabriel:"Freezer Frango",Amanda:"Freezer Carne",Dandara:"Freezer",Luísa:"Batateira",Júlia:"Folga"},
{Gabriel:"Folga",Amanda:"Freezer Frango",Dandara:"Freezer Carne ■ Lixeiras",Luísa:"Freezer",Júlia:"Batateira"},
{Gabriel:"Batateira",Amanda:"Folga",Dandara:"Freezer Frango",Luísa:"Freezer Carne ■ Lixeiras",Júlia:"Freezer"},
{Gabriel:"Freezer Carne",Amanda:"Freezer",Dandara:"Batateira",Luísa:"Folga",Júlia:"Freezer Frango ■ Lixeiras"},
{Gabriel:"Lixeiras ■ Freezer Frango",Amanda:"Freezer Carne",Dandara:"Freezer",Luísa:"Batateira",Júlia:"—"},
{Gabriel:"Freezer",Amanda:"Batateira",Dandara:"Lixeiras ■ Freezer Carne",Luísa:"Freezer Frango",Júlia:"—"}];

function hojeIndice(){return new Date().getDay()}
function esc(v){return String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;")}
function dataHoje(){return new Date().toLocaleDateString("pt-BR")}
function toggleMenu(){document.getElementById("sidebar").classList.toggle("minimizado");document.getElementById("conteudo").classList.toggle("expandido")}
function alternarMenuCelular(){document.querySelector(".menu").classList.toggle("fechado")}
function alternarTema(){document.body.classList.toggle("escuro");localStorage.setItem("tema",document.body.classList.contains("escuro")?"escuro":"claro")}
if(localStorage.getItem("tema")==="escuro")document.body.classList.add("escuro");
function mostrarPagina(id,link){document.querySelectorAll(".pagina").forEach(p=>p.classList.remove("ativa"));document.querySelectorAll(".menu a").forEach(a=>a.classList.remove("ativo"));document.getElementById("pag-"+id).classList.add("ativa");if(link)link.classList.add("ativo")}
function atualizarRelogio(){const h=new Date().toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit",second:"2-digit"});document.querySelectorAll(".relogio").forEach(x=>x.textContent=h)}atualizarRelogio();setInterval(atualizarRelogio,1000);

function alternarFormAviso(){document.getElementById("formAvisoContainer").classList.toggle("visivel")}
function alternarFormAvisoPre(){document.getElementById("formAvisoContainerPre").classList.toggle("visivel")}
function salvarAviso(){const t=document.getElementById("novoTextoAviso").value.trim();if(!t)return alert("⚠️ Digite uma mensagem!");AVISO_REF.set({mensagem:t,data:dataHoje(),hora:new Date().toLocaleTimeString("pt-BR"),atualizadoPor:"Sistema"}).then(()=>document.getElementById("formAvisoContainer").classList.remove("visivel")).catch(e=>alert("❌ "+e.message))}
function salvarAvisoPre(){const t=document.getElementById("novoTextoAvisoPre").value.trim();if(!t)return alert("⚠️ Digite uma mensagem!");AVISO_PRE_REF.set({mensagem:t,data:dataHoje(),hora:new Date().toLocaleTimeString("pt-BR"),atualizadoPor:"Sistema"}).then(()=>document.getElementById("formAvisoContainerPre").classList.remove("visivel")).catch(e=>alert("❌ "+e.message))}
function limparAviso(){if(confirm("🗑️ Limpar aviso?")){document.getElementById("novoTextoAviso").value="";AVISO_REF.remove()}}
AVISO_REF.on("value",s=>{const d=s.val();if(d?.mensagem){document.getElementById("textoAviso").innerHTML=esc(d.mensagem).replace(/\n/g,"<br>");document.getElementById("novoTextoAviso").value=d.mensagem}})
AVISO_PRE_REF.on("value",s=>{const d=s.val();if(d?.mensagem){document.getElementById("textoAvisoPre").innerHTML=esc(d.mensagem).replace(/\n/g,"<br>");document.getElementById("novoTextoAvisoPre").value=d.mensagem}})

function abrirEdicaoFech(){document.getElementById("painelEdicaoFech").classList.toggle("visivel")}
function abrirEdicaoPre(){document.getElementById("painelEdicaoPre").classList.toggle("visivel")}

const OPCOES_FECH=["—","— FOLGA —","Broiler","Coifa","Mesa","Louça","Broiler + Mesa","Mesa + Broiler","Mesa + Coifa","Louça + Mesa","Mesa + Louça","Louça + Broiler","Coifa + Mesa","Louça + Coifa"];
const OPCOES_PRE=["—","Folga","Freezer","Batateira","Freezer Frango","Freezer Carne","Lixeiras","Freezer Carne ■ Lixeiras","Freezer Frango ■ Lixeiras","Lixeiras ■ Freezer Frango","Lixeiras ■ Freezer Carne"];
function campoEscala(valor,atributos,opcoes){const atual=String(valor||"—");const lista=[...opcoes];if(!lista.includes(atual))lista.push(atual);return `<select ${atributos}>${lista.map(o=>`<option value="${esc(o)}" ${o===atual?"selected":""}>${esc(o)}</option>`).join("")}</select>`}
function renderizarCabecalhoFech(){/* Layout atual usa cartões, não cabeçalho de tabela. */}
function renderizarCabecalhoPre(){/* Layout atual usa cartões, não cabeçalho de tabela. */}

function renderizarEscalaFechamento(){
 const i=hojeIndice(),d=escalaFechamentoAtual[i]||{};
 const corpo=document.getElementById("corpoFechamento");
 const folga=String(d.folga||"—");
 let html=`<div class="escala-topo"><div class="dia-label">Escala de hoje</div><h3>${diasSemana[i]}</h3><div class="data-label">${dataHoje()}</div><div class="folga-hoje">🌴 Folga: ${esc(folga)}</div></div>`;
 if(podeEditarFechamento){html+=`<div class="escala-folga-edit"><strong>🌴 Folga do dia</strong><br><input data-tipo="folga" list="opcoesFolga" value="${esc(folga)}" aria-label="Folga" style="margin-top:7px;width:100%;max-width:100%;min-height:42px;padding:8px;border:1px solid #ff9a45;border-radius:9px;background:var(--card);color:var(--texto)"></div>`}
 html+='<div class="escala-lista">';
 funcionariosFechamento.forEach((n,idx)=>{const valor=String(d[n]||"—"),folgaPessoa=valor.toLowerCase().includes('folga');const campo=podeEditarFechamento?`<select data-func="${esc(n)}" aria-label="Função de ${esc(n)}">${[...new Set([...OPCOES_FECH,valor])].map(o=>`<option value="${esc(o)}" ${o===valor?'selected':''}>${esc(o)}</option>`).join('')}</select>`:`<span class="escala-tarefa ${folgaPessoa?'folga':''}">${esc(valor)}</span>`;html+=`<div class="escala-item"><div class="escala-avatar">${esc(n.trim().split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase())}</div><div class="escala-pessoa">${esc(n)}</div>${campo}</div>`});
 html+='</div>';corpo.innerHTML=html;
 if(podeEditarFechamento)corpo.querySelectorAll('input,select').forEach(inp=>inp.addEventListener('change',()=>{if(inp.dataset.tipo==='folga')d.folga=inp.value;else d[inp.dataset.func]=inp.value;escalaFechamentoAtual[i]=d;renderizarEscalaFechamento()}));
}
function liberarEdicaoFech(){if(document.getElementById("senhaFech").value===SENHA_EDICAO){podeEditarFechamento=true;document.getElementById("statusEditFechado").textContent="🔓 Liberado";document.getElementById("statusEditFechado").className="status-edicao liberado";document.getElementById("botoesSalvarFech").style.display="block";renderizarEscalaFechamento()}else alert("❌ Senha incorreta!")}
function bloquearEdicaoFech(){podeEditarFechamento=false;document.getElementById("statusEditFechado").textContent="🔒 Bloqueado";document.getElementById("statusEditFechado").className="status-edicao bloqueado";document.getElementById("botoesSalvarFech").style.display="none";document.getElementById("senhaFech").value="";renderizarEscalaFechamento()}
function salvarEscalaFechamento(){ESCALA_FECHAMENTO_REF.set(escalaFechamentoAtual).then(()=>alert("✅ Escala salva e sincronizada!")).catch(e=>alert("❌ "+e.message))}
function recarregarEscalaFech(){if(confirm("🔄 Restaurar a escala salva?"))ESCALA_FECHAMENTO_REF.once("value").then(s=>{escalaFechamentoAtual=Array.isArray(s.val())&&s.val().length?s.val():JSON.parse(JSON.stringify(ESCALA_FECHAMENTO_PADRAO));renderizarEscalaFechamento()})}
function adicionarFuncionarioFech(){const n=prompt("Nome do funcionário:");if(n?.trim()){const nome=n.trim();if(funcionariosFechamento.includes(nome))return alert("Esse funcionário já existe.");funcionariosFechamento.push(nome);escalaFechamentoAtual.forEach(d=>{if(d&&!d[nome])d[nome]=""});EQUIPE_FECHAMENTO_REF.set(funcionariosFechamento);renderizarCabecalhoFech();renderizarEscalaFechamento()}}
ESCALA_FECHAMENTO_REF.on("value",s=>{escalaFechamentoAtual=Array.isArray(s.val())&&s.val().length?s.val():JSON.parse(JSON.stringify(ESCALA_FECHAMENTO_PADRAO));renderizarEscalaFechamento()})
EQUIPE_FECHAMENTO_REF.on("value",s=>{funcionariosFechamento=s.val()||["Daniel","Mariana","Julyan","Thuanney"];renderizarCabecalhoFech();renderizarEscalaFechamento()})

function renderizarEscalaPre(){
 const i=hojeIndice(),d=escalaPreAtual[i]||{},corpo=document.getElementById("corpoPre");
 let html=`<div class="escala-topo"><div class="dia-label">Escala de hoje</div><h3>${diasSemana[i]}</h3><div class="data-label">${dataHoje()}</div><div class="folga-hoje">🍔 Pré-fechamento do dia</div></div><div class="escala-lista">`;
 funcionariosPre.forEach((n,idx)=>{const valor=String(d[n]||"—"),folgaPessoa=valor.toLowerCase().includes('folga');const campo=podeEditarPre?`<select data-func="${esc(n)}" aria-label="Função de ${esc(n)}">${[...new Set([...OPCOES_PRE,valor])].map(o=>`<option value="${esc(o)}" ${o===valor?'selected':''}>${esc(o)}</option>`).join('')}</select>`:`<span class="escala-tarefa ${folgaPessoa?'folga':''}">${esc(valor)}</span>`;html+=`<div class="escala-item"><div class="escala-avatar">${esc(n.trim().split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase())}</div><div class="escala-pessoa">${esc(n)}</div>${campo}</div>`});
 html+='</div>';corpo.innerHTML=html;
 if(podeEditarPre)corpo.querySelectorAll('select').forEach(inp=>inp.addEventListener('change',()=>{d[inp.dataset.func]=inp.value;escalaPreAtual[i]=d;renderizarEscalaPre()}));
}
function liberarEdicaoPre(){if(document.getElementById("senhaPre").value===SENHA_EDICAO){podeEditarPre=true;document.getElementById("statusEditPre").textContent="🔓 Liberado";document.getElementById("statusEditPre").className="status-edicao liberado";document.getElementById("botoesSalvarPre").style.display="block";renderizarEscalaPre()}else alert("❌ Senha incorreta!")}
function bloquearEdicaoPre(){podeEditarPre=false;document.getElementById("statusEditPre").textContent="🔒 Bloqueado";document.getElementById("statusEditPre").className="status-edicao bloqueado";document.getElementById("botoesSalvarPre").style.display="none";document.getElementById("senhaPre").value="";renderizarEscalaPre()}
function salvarEscalaPre(){ESCALA_PRE_REF.set(escalaPreAtual).then(()=>alert("✅ Escala salva e sincronizada!")).catch(e=>alert("❌ "+e.message))}
function recarregarEscalaPre(){if(confirm("🔄 Restaurar a escala salva?"))ESCALA_PRE_REF.once("value").then(s=>{escalaPreAtual=Array.isArray(s.val())&&s.val().length?s.val():JSON.parse(JSON.stringify(ESCALA_PRE_PADRAO));renderizarEscalaPre()})}
function adicionarFuncionarioPre(){const n=prompt("Nome do funcionário:");if(n?.trim()){const nome=n.trim();if(funcionariosPre.includes(nome))return alert("Esse funcionário já existe.");funcionariosPre.push(nome);escalaPreAtual.forEach(d=>{if(d&&!d[nome])d[nome]=""});EQUIPE_PRE_REF.set(funcionariosPre);renderizarCabecalhoPre();renderizarEscalaPre()}}
ESCALA_PRE_REF.on("value",s=>{escalaPreAtual=Array.isArray(s.val())&&s.val().length?s.val():JSON.parse(JSON.stringify(ESCALA_PRE_PADRAO));renderizarEscalaPre()})
EQUIPE_PRE_REF.on("value",s=>{funcionariosPre=s.val()||["Gabriel","Amanda","Dandara","Luísa","Júlia"];renderizarCabecalhoPre();renderizarEscalaPre()})

function calcularValidade(){const f=document.getElementById("dataFab").value,t=document.getElementById("tipoValidade").value,q=parseInt(document.getElementById("quantidade").value);if(!f||!q)return alert("⚠️ Preencha todos os campos!");const d=new Date(f);t==="dias"?d.setDate(d.getDate()+q):d.setMonth(d.getMonth()+q);document.getElementById("caixaResultado").style.display="block";document.getElementById("dtValidade").textContent=d.toLocaleDateString("pt-BR")}
function usarHoje(){document.getElementById("dataFab").value=new Date().toISOString().split("T")[0]}

function verificarOutro(){document.getElementById("campoOutroProduto").style.display=document.getElementById("produto").value==="outros"?"flex":"none"}
function atualizarCampoQuantidade(){const g=document.getElementById("unidadeDesperdicio").value==="g";document.getElementById("labelQuantidade").textContent=g?"Quantidade (g):":"Quantidade (un):";document.getElementById("qtdDesperdicio").step="1";document.getElementById("qtdDesperdicio").placeholder=g?"Ex: 250":"Ex: 5"}
function normalizarNomeProduto(n){return String(n||"").trim().replace(/\s+/g," ").toLocaleLowerCase("pt-BR")}
function obterProdutoDesperdicio(){let p=document.getElementById("produto").value;if(p==="outros")p=document.getElementById("produtoOutro").value.trim();if(!p){alert("⚠️ Digite o nome do produto!");return""}return p.trim()}
function limparCamposDesperdicio(){document.getElementById("produto").value="";document.getElementById("produtoOutro").value="";document.getElementById("qtdDesperdicio").value="";document.getElementById("unidadeDesperdicio").value="un";verificarOutro();atualizarCampoQuantidade()}
function adicionarDesperdicio(){
 const produto=obterProdutoDesperdicio(),qtd=parseInt(document.getElementById("qtdDesperdicio").value,10),unidade=document.getElementById("unidadeDesperdicio").value;
 if(!produto||!Number.isInteger(qtd)||qtd<=0)return alert("⚠️ Informe produto e quantidade maior que zero!");
 DESPERDICIO_REF.once("value").then(s=>{
  const dados=s.val()||{},chave=normalizarNomeProduto(produto);
  const encontrados=Object.entries(dados).filter(([,x])=>x&&normalizarNomeProduto(x.produto)===chave&&(x.unidade||"un")===unidade);
  if(!encontrados.length)return DESPERDICIO_REF.push({produto,quantidade:qtd,unidade,horario:new Date().toLocaleString("pt-BR")});
  const [id,item]=encontrados[0],total=encontrados.reduce((a,[,x])=>a+(parseInt(x.quantidade,10)||0),0)+qtd,up={};
  up[id]={produto:item.produto||produto,quantidade:total,unidade,horario:new Date().toLocaleString("pt-BR")};encontrados.slice(1).forEach(([x])=>up[x]=null);return DESPERDICIO_REF.update(up);
 }).then(limparCamposDesperdicio).catch(e=>alert("❌ "+e.message))
}
function alterarQuantidadeDesperdicio(id,delta){
 DESPERDICIO_REF.once("value").then(s=>{
  const dados=s.val()||{},base=dados[id];if(!base)return;
  const unidade=base.unidade||"un",chave=normalizarNomeProduto(base.produto);
  const encontrados=Object.entries(dados).filter(([,x])=>x&&normalizarNomeProduto(x.produto)===chave&&(x.unidade||"un")===unidade);
  const total=encontrados.reduce((a,[,x])=>a+(parseInt(x.quantidade,10)||0),0)+delta,up={};
  if(total<=0){encontrados.forEach(([x])=>up[x]=null);return DESPERDICIO_REF.update(up)}
  const [idp]=encontrados;up[idp]={produto:base.produto,quantidade:total,unidade,horario:new Date().toLocaleString("pt-BR")};encontrados.slice(1).forEach(([x])=>up[x]=null);return DESPERDICIO_REF.update(up)
 }).catch(e=>alert("❌ "+e.message))
}
function excluirDesperdicio(id){
 if(!confirm("🗑️ Excluir este item?"))return;
 DESPERDICIO_REF.once("value").then(s=>{const dados=s.val()||{},base=dados[id];if(!base)return;const unidade=base.unidade||"un",chave=normalizarNomeProduto(base.produto),up={};Object.entries(dados).forEach(([x,v])=>{if(v&&normalizarNomeProduto(v.produto)===chave&&(v.unidade||"un")===unidade)up[x]=null});return DESPERDICIO_REF.update(up)})
}
function limparDesperdicios(){if(confirm("⚠️ Zerar TODOS os registros de desperdício?"))DESPERDICIO_REF.remove()}
DESPERDICIO_REF.on("value",s=>{
 const dados=s.val()||{},corpo=document.getElementById("corpoDesp");corpo.innerHTML="";let un=0,g=0;const grupos={};
 Object.entries(dados).forEach(([id,x])=>{if(!x?.produto)return;const unidade=x.unidade||"un",chave=normalizarNomeProduto(x.produto)+"__"+unidade;if(!grupos[chave])grupos[chave]={id,produto:x.produto,quantidade:0,unidade,horario:x.horario||""};grupos[chave].quantidade+=parseInt(x.quantidade,10)||0;if(x.horario)grupos[chave].horario=x.horario});
 Object.values(grupos).forEach(x=>{
  if(x.unidade==="g")g+=x.quantidade;else un+=x.quantidade;
  const tr=document.createElement("tr"),s=x.unidade==="g"?"g":"un";
  tr.innerHTML=`<td>${esc(x.horario)}</td><td class="produto-registro">${esc(x.produto)}</td><td><span class="qtd-valor">${x.quantidade} ${s}</span></td><td><div class="controle-qtd"><button class="btn-qtd menos" onclick="alterarQuantidadeDesperdicio('${x.id}',-1)">−</button><button class="btn-qtd mais" onclick="alterarQuantidadeDesperdicio('${x.id}',1)">+</button></div></td><td><button class="vermelho" onclick="excluirDesperdicio('${x.id}')">🗑️</button></td>`;corpo.appendChild(tr)
 });
 let r="<strong>Totais:</strong> ";if(un)r+=`${un} unidades`;if(un&&g)r+=" • ";if(g)r+=`${g} g`;if(!un&&!g)r+="0 unidades";r+=` • <strong>${Object.keys(grupos).length}</strong> registro(s)`;document.getElementById("resumo").innerHTML=r
});

function adicionarBreak(turno){const cap=turno[0].toUpperCase()+turno.slice(1),nome=document.getElementById("nomeFunc"+cap).value.trim(),itens=document.getElementById("itens"+cap).value.trim(),gerente=document.getElementById("gerenteTurno").value.trim()||"Não informado";if(!nome||!itens)return alert("⚠️ Preencha nome e itens!");BREAKS_REF.push({turno:turno==="manha"?"☀️ Manhã":"🌙 Noite",nome,itens,gerente,horarioCompleto:new Date().toLocaleString("pt-BR")}).then(()=>{document.getElementById("nomeFunc"+cap).value="";document.getElementById("itens"+cap).value="";alert("✅ Break registrado!")})}
BREAKS_REF.on("value",s=>{const d=s.val()||{},c=document.getElementById("corpoBreaks");c.innerHTML="";let n=0;Object.entries(d).forEach(([id,x])=>{n++;const tr=document.createElement("tr");tr.innerHTML=`<td>${esc(x.turno)}</td><td>${esc(x.nome)}</td><td>${esc(x.itens)}</td><td>${esc(x.gerente)}</td><td>${esc(x.horarioCompleto)}</td><td><button class="vermelho" onclick="excluirBreak('${id}')">🗑️</button></td>`;c.appendChild(tr)});document.getElementById("resumoBreaks").innerHTML=`<strong>Total:</strong> ${n} registros`})
function excluirBreak(id){if(confirm("🗑️ Excluir este registro?"))BREAKS_REF.child(id).remove()}
function limparBreaks(){if(confirm("⚠️ Zerar TODOS os registros?"))BREAKS_REF.remove()}

const folgas={"1":{nome:"Dandara",dia:1},"2":{nome:"Luísa",dia:2},"3":{nome:"Gabriel",dia:3},"4":{nome:"Amanda",dia:4},"5":{nome:"Julyan",dia:5}};
function calcularFolga(){const e=document.getElementById("funcionario").value;if(!e)return document.getElementById("resFolga").style.display="none";const f=folgas[e],h=new Date(),dh=h.getDay(),d=(f.dia-dh+7)%7||7;document.getElementById("resFolga").style.display="block";document.getElementById("textoFolga").innerHTML=`<strong>${f.nome}</strong> sua folga é na <strong>${diasSemana[f.dia]}</strong>.<br>Faltam <strong>${d} dia${d!==1?"s":""}</strong> até a folga! 🎉`}

document.getElementById("dataBreak").value=new Date().toISOString().split("T")[0];
atualizarCampoQuantidade();
</script>
</body>
</html>
