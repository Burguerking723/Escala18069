eInt(document.getElementById('quantidade').value);     if(!fab||!qtd){alert('⚠️ Preencha todos os campos!');return;}     let dt = new Date(fab);     if(tipo==='dias') dt.setDate(dt.getDate()+qtd+1);     else {dt.setMonth(dt.getMonth()+qtd);dt.setDate(dt.getDate()+1);}     document.getElementById('dtValidade').textContent = `${String(dt.getDate()).padStart(2,'0')}/${String(dt.getMonth()+1).padStart(2,'0')}/${dt.getFullYear()}`;     document.getElementById('caixaResultado').style.display='block'; }  function verificarOutro(){     const sel = document.getElementById('produto').value;     document.getElementById('campoOutroProduto').style.display = sel === 'outros' ? 'flex' : 'none'; }  async function adicionarDesperdicio(){     await verificarNovoDia();     let prod = document.getElementById('produto').value;     const qtd = parseInt(document.getElementById('qtdDesperdicio').value);     if(prod === 'outros'){         prod = document.getElementById('produtoOutro').value.trim();         if(!prod){alert('⚠️ Digite o nome do item!');return;}     }     if(!prod){alert('⚠️ Selecione um produto!');return;}     if(!qtd || qtd <= 0){alert('⚠️ Informe uma quantidade válida!');return;}     const agora = new Date();     const horario = `${String(agora.getHours()).padStart(2,'0')}:${String(agora.getMinutes()).padStart(2,'0')}`;     await DESPERDICIO_REF.push({data:horario,produto:prod,qtd:qtd});     document.getElementById('produto').value='';     document.getElementById('produtoOutro').value='';     document.getElementById('campoOutroProduto').style.display='none';     document.getElementById('qtdDesperdicio').value=''; }  function carregarDesperdicios(snapshot){     document.getElementById('corpoDesp').innerHTML='';     const dados = snapshot.val();     let total=0;     if(dados){         Object.keys(dados).forEach(key=>{             const item = dados[key];             const tr = document.createElement('tr');             tr.innerHTML = `<td>${item.data}</td><td>${item.produto}</