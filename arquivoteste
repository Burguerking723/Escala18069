alue;                     desenharTabelaPre();                 };                 input.onblur = salvar;                 input.onkeydown = e=>{ if(e.key==='Enter') salvar(); };             };         });     } }  async function salvarEscalaPre(){     await ESCALA_PRE_REF.set(escalaPreAtual);     alert('✅ Escala salva! Atualizada em tempo real para todos.'); }  async function recarregarEscalaPre(){     if(confirm('Restaurar escala padrão?')){         escalaPreAtual = JSON.parse(JSON.stringify(ESCALA_PRE_PADRAO));         await ESCALA_PRE_REF.set(escalaPreAtual);         desenharTabelaPre();         alert('✅ Restaurada e salva!');     } }  function carregarEscalaPre(snap){     const dados = snap.val();     escalaPreAtual = dados ? dados : JSON.parse(JSON.stringify(ESCALA_PRE_PADRAO));     desenharTabelaPre(); }  // ========== DEMAIS FUNÇÕES ========== const diasSemana = ["Domingo","Segunda-feira","Terça-feira","Quarta-feira","Quinta-feira","Sexta-feira","Sábado"]; const sidebar = document.getElementById('sidebar'); const conteudo = document.getElementById('conteudo');  function getDataReferencia(){     const agora = new Date();     const hora = agora.getHours();     const data = new Date(agora);     if(hora < 3) data.setDate(data.getDate() - 1);     return `${data.getFullYear()}-${String(data.getMonth()+1).padStart(2,'0')}-${String(data.getDate()).padStart(2,'0')}`; }  async function verificarNovoDia(){     const dataAtual = getDataReferencia();     const snap = await DATA_REF.once('value');     const dataSalva = snap.val();     if(dataSalva && dataSalva !== dataAtual){         await DESPERDICIO_REF.remove();         await BREAKS_REF.remove();         await DATA_REF.set(dataAtual);     }     if(!dataSalva) await DATA_REF.set(dataAtual); }  function toggleMenu(){     sidebar.classList.toggle('minimizado');     conteudo.classList.toggle('expandido');     document.querySelector('.btn-toggle').textContent = sidebar.classList.contains('minimizado') ? '▶' : '◀'; }  function