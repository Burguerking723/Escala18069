<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Escala BK</title>
    <style>
        @font-face {
            font-family: 'Poppins';
            font-style: normal;
            font-weight: 300;
            font-display: swap;
            src: url(https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLDz8V1tvEv-L.ttf) format('truetype');
        }
        @font-face {
            font-family: 'Poppins';
            font-style: normal;
            font-weight: 400;
            font-display: swap;
            src: url(https://fonts.gstatic.com/s/poppins/v20/pxiEyp8kv8JHgFVrFJDUdVNF.ttf) format('truetype');
        }
        @font-face {
            font-family: 'Poppins';
            font-style: normal;
            font-weight: 500;
            font-display: swap;
            src: url(https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLGT9V1tvEv-L.ttf) format('truetype');
        }
        @font-face {
            font-family: 'Poppins';
            font-style: normal;
            font-weight: 600;
            font-display: swap;
            src: url(https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLEj6V1tvEv-L.ttf) format('truetype');
        }
        @font-face {
            font-family: 'Poppins';
            font-style: normal;
            font-weight: 700;
            font-display: swap;
            src: url(https://fonts.gstatic.com/s/poppins/v20/pxiByp8kv8JHgFVrLCz7V1tvEv-L.ttf) format('truetype');
        }

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins',sans-serif;
        }
        body{
            background:linear-gradient(135deg,#ff7b00,#d62300);
            min-height:100vh;
            display:flex;
        }
        aside{
            width:260px;
            background:#222;
            color:white;
            padding:25px 15px;
            box-shadow:5px 0 15px rgba(0,0,0,.2);
            position:fixed;
            height:100vh;
            overflow-y:auto;
            transition: width 0.35s ease, padding 0.35s ease;
            z-index:100;
        }
        aside.minimizado{
            width:70px;
            padding:25px 10px;
        }
        aside.minimizado .logo h1,
        aside.minimizado .logo p,
        aside.minimizado .menu a span,
        aside.minimizado .menu button span,
        aside.minimizado input::placeholder{
            display:none;
        }
        aside.minimizado .menu a,
        aside.minimizado .menu button{
            text-align:center;
            padding:15px 0;
            font-size:18px;
        }
        aside.minimizado input{
            padding:12px 5px;
        }
        .btn-toggle{
            width:100%;
            padding:12px;
            margin-bottom:20px;
            border:none;
            border-radius:10px;
            background:#ff7b00;
            color:#000;
            cursor:pointer;
            font-weight:bold;
            font-size:18px;
            transition:.3s;
        }
        .btn-toggle:hover{
            background:#d62300;
            color:white;
        }
        .logo{
            text-align:center;
            margin-bottom:25px;
            transition:opacity 0.2s;
        }
        aside.minimizado .logo{
            margin-bottom:15px;
        }
        .logo h1{
            font-size:24px;
            transition:opacity 0.2s;
        }
        .logo p{
            font-size:12px;
            opacity:.7;
        }
        .menu a{
            display:block;
            color:white;
            text-decoration:none;
            padding:14px 12px;
            margin-bottom:8px;
            border-radius:12px;
            transition:.3s;
            font-weight:500;
            cursor:pointer;
            font-size:15px;
        }
        .menu a:hover, .menu a.ativo{
            background:#d62300;
            transform:translateX(5px);
        }
        main{
            flex:1;
            padding:30px;
            margin-left:260px;
            overflow:auto;
            transition: margin-left 0.35s ease;
        }
        main.expandido{
            margin-left:70px;
        }
        header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:30px;
            flex-wrap:wrap;
            gap:15px;
        }
        header h2{
            color:white;
            font-size:32px;
        }
        .relogio{
            background:white;
            padding:12px 20px;
            border-radius:12px;
            font-weight:600;
            color:#d62300;
            box-shadow:0 5px 15px rgba(0,0,0,.2);
        }
        .mes-ano{
            background:white;
            padding:12px 15px;
            border-radius:12px;
            color:#d62300;
            font-weight:600;
            display:flex;
            gap:8px;
            align-items:center;
        }
        .cards{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
            gap:20px;
            margin-bottom:30px;
        }
        .card{
            background:white;
            border-radius:20px;
            padding:20px;
            box-shadow:0 10px 25px rgba(0,0,0,.15);
            transition:.3s;
        }
        .card:hover{
            transform:translateY(-5px);
        }
        .card h3{
            font-size:32px;
            color:#d62300;
            margin-bottom:5px;
        }
        .card span{
            color:#444;
            font-weight:500;
        }
        table{
            width:100%;
            border-collapse:separate;
            border-spacing:0;
            border-radius:20px;
            overflow:hidden;
            background:white;
            box-shadow:0 10px 25px rgba(0,0,0,.15);
        }
        th{
            background:#d62300;
            color:white;
            padding:15px 10px;
            text-align:center;
            font-weight:600;
        }
        td{
            padding:14px 10px;
            text-align:center;
            border-bottom:1px solid #eee;
            color:#333;
            font-weight:500;
        }
        tr:hover td{
            background:#fff2f0;
        }
        .pagina{
            display:none;
        }
        .pagina.ativa{
            display:block;
        }
        .aviso-folgas{
            background:rgba(255,255,255,0.95);
            border-left:5px solid #d62300;
            padding:15px 20px;
            border-radius:12px;
            margin-top:25px;
            color:#333;
            font-weight:500;
            line-height:1.6;
        }
        .menu hr{
            border:none;
            border-top:1px solid #444;
            margin:12px 0;
        }
        .menu button{
            width:100%;
            padding:12px;
            margin-bottom:6px;
            border:none;
            border-radius:10px;
            background:#444;
            color:white;
            cursor:pointer;
            font-weight:500;
            transition:.3s;
            font-size:14px;
        }
        .menu button:hover{
            background:#d62300;
        }
        input#pesquisa{
            width:100%;
            padding:12px;
            border:none;
            border-radius:10px;
            background:#333;
            color:white;
            margin:8px 0;
        }

        @media(max-width:768px){
            aside{
                position:relative;
                width:100%;
                height:auto;
            }
            aside.minimizado{
                width:100%;
                padding:15px;
            }
            main{
                margin-left:0;
                padding:20px;
            }
            main.expandido{
                margin-left:0;
            }
            table{
                font-size:13px;
            }
            th, td{
                padding:10px 5px;
            }
        }
    </style>
</head>
<body>

<aside id="sidebar">
    <button class="btn-toggle" onclick="toggleMenu()">◀</button>
    <div class="logo">
        <h1>🍔 BK Escala</h1>
        <p>Sistema de Escala</p>
    </div>
    <nav class="menu">
        <a class="ativo" onclick="mostrarPagina('fechamento')">📋 <span>Fechamento</span></a>
        <a onclick="mostrarPagina('pre-fechamento')">📝 <span>Pré-Fechamento</span></a>
        <hr>
        <button onclick="mostrarTodos()">📅 <span>Escala Completa</span></button>
        <button onclick="filtrarDia('seg')">📌 <span>Segunda</span></button>
        <button onclick="filtrarDia('ter')">📌 <span>Terça</span></button>
        <button onclick="filtrarDia('qua')">📌 <span>Quarta</span></button>
        <button onclick="filtrarDia('qui')">📌 <span>Quinta</span></button>
        <button onclick="filtrarDia('sex')">📌 <span>Sexta</span></button>
        <button onclick="filtrarDia('sab')">📌 <span>Sábado</span></button>
        <button onclick="filtrarDia('dom')">📌 <span>Domingo</span></button>
        <input type="text" id="pesquisa" placeholder="🔍 Pesquisar..." onkeyup="pesquisar()">
        <button onclick="window.print()" style="background:#ff7b00; color:#000; margin-top:8px;">🖨️ <span>Imprimir</span></button>
    </nav>
</aside>

<main id="conteudo">
    <!-- ====================================== -->
    <!-- PÁGINA 1: ESCALA DE FECHAMENTO -->
    <!-- ====================================== -->
    <div class="pagina ativa" id="pag-fechamento">
        <header>
            <h2>📋 Escala de Fechamento</h2>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <div class="mes-ano">
                    <span id="mesAtual"></span> / <span id="anoAtual"></span>
                </div>
                <div class="relogio" id="relogio"></div>
            </div>
        </header>

        <div class="cards">
            <div class="card">
                <h3>7</h3>
                <span>Dias da Semana</span>
            </div>
            <div class="card">
                <h3>8</h3>
                <span>Funcionários</span>
            </div>
            <div class="card">
                <h3>4</h3>
                <span>Funções</span>
            </div>
            <div class="card">
                <h3>100%</h3>
                <span>Organização</span>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Dia</th>
                    <th>Broiler</th>
                    <th>Coifa</th>
                    <th>Mesa</th>
                    <th>Louça / SEG</th>
                </tr>
            </thead>
            <tbody id="corpo-fechamento">
                <tr id="seg">
                    <td>Segunda</td>
                    <td>C.Daniel</td>
                    <td>Thuanny</td>
                    <td>Matheus</td>
                    <td>Mariana</td>
                </tr>
                <tr id="ter">
                    <td>Terça</td>
                    <td>Mariana</td>
                    <td>Matheus</td>
                    <td>Julyan</td>
                    <td>Tayná</td>
                </tr>
                <tr id="qua">
                    <td>Quarta</td>
                    <td>Tayná</td>
                    <td>Julyan</td>
                    <td>C.Daniel</td>
                    <td>Thuanny</td>
                </tr>
                <tr id="qui">
                    <td>Quinta</td>
                    <td>Matheus</td>
                    <td>Tayná</td>
                    <td>Julyan</td>
                    <td>Daniel</td>
                </tr>
                <tr id="sex">
                    <td>Sexta</td>
                    <td>Julyan</td>
                    <td>C.Daniel</td>
                    <td>Tayná</td>
                    <td>Mariana</td>
                </tr>
                <tr id="sab">
                    <td>Sábado</td>
                    <td>Thuanny</td>
                    <td>Mariana</td>
                    <td>C.Daniel</td>
                    <td>Matheus</td>
                </tr>
                <tr id="dom">
                    <td>Domingo</td>
                    <td>Sorteio</td>
                    <td>Sorteio</td>
                    <td>Sorteio</td>
                    <td>Sorteio</td>
                </tr>
            </tbody>
        </table>

        <div class="aviso-folgas">
            ⚠️ Domingo: Sorteio automático — apenas 1 sorteio por domingo.
        </div>
    </div>

    <!-- ====================================== -->
    <!-- PÁGINA 2: PRÉ-FECHAMENTO -->
    <!-- ====================================== -->
    <div class="pagina" id="pag-pre-fechamento">
        <header>
            <h2>📝 Escala de Pré-Fechamento</h2>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <div class="mes-ano">
                    <span id="mesAtual2"></span> / <span id="anoAtual2"></span>
                </div>
                <div class="relogio" id="relogio2"></div>
            </div>
        </header>

        <div class="cards">
            <div class="card">
                <h3>7</h3>
                <span>Dias da Semana</span>
            </div>
            <div class="card">
                <h3>4</h3>
                <span>Funcionários</span>
            </div>
            <div class="card">
                <h3>5</h3>
                <span>Funções</span>
            </div>
            <div class="card">
                <h3>100%</h3>
                <span>Organização</span>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Dia</th>
                    <th>Lixeiras</th>
                    <th>Frozen</th>
                    <th>Batateira</th>
                    <th>Freezer Carne</th>
                    <th>Freezer Frango</th>
                </tr>
            </thead>
            <tbody id="corpo-pre">
                <tr id="seg">
                    <td>Segunda</td>
                    <td>Amanda</td>
                    <td>Luisa</td>
                    <td>Amanda</td>
                    <td>Luisa</td>
                    <td>Luisa</td>
                </tr>
                <tr id="ter">
                    <td>Terça</td>
                    <td>Dandara</td>
                    <td>Gabriel</td>
                    <td>Amanda</td>
                    <td>Gabriel</td>
                    <td>Dandara</td>
                </tr>
                <tr id="qua">
                    <td>Quarta</td>
                    <td>Amanda</td>
                    <td>Luisa</td>
                    <td>Dandara</td>
                    <td>Amanda</td>
                    <td>Luisa</td>
                </tr>
                <tr id="qui">
                    <td>Quinta</td>
                    <td>Gabriel</td>
                    <td>Luisa</td>
                    <td>Dandara</td>
                    <td>Gabriel</td>
                    <td>Dandara</td>
                </tr>
                <tr id="sex">
                    <td>Sexta</td>
                    <td>Gabriel</td>
                    <td>Amanda</td>
                    <td>Luisa</td>
                    <td>Dandara</td>
                    <td>Gabriel</td>
                </tr>
                <tr id="sab">
                    <td>Sábado</td>
                    <td>Luisa</td>
                    <td>Dandara</td>
                    <td>Gabriel</td>
                    <td>Amanda</td>
                    <td>Luisa</td>
                </tr>
                <tr id="dom">
                    <td>Domingo</td>
                    <td>Sorteio</td>
                    <td>Sorteio</td>
                    <td>Sorteio</td>
                    <td>Sorteio</td>
                    <td>Sorteio</td>
                </tr>
            </tbody>
        </table>

        <div class="aviso-folgas">
            ✅ Folgas atualizadas:<br>
            • Gabriel → Quarta-feira (NÃO folga mais na Segunda)<br>
            • Luisa → Terça-feira<br>
            • Amanda → Quinta-feira<br>
            • Dandara → Segunda-feira<br>
            <br>
            ⚠️ Domingo: Sorteio automático — apenas 1 sorteio por domingo.
        </div>
    </div>

</main>

<script>
const sidebar = document.getElementById('sidebar');
const conteudo = document.getElementById('conteudo');

// FUNÇÃO PARA MINIMIZAR/MAXIMIZAR O MENU
function toggleMenu(){
    sidebar.classList.toggle('minimizado');
    conteudo.classList.toggle('expandido');
    
    // Alterna o símbolo do botão
    const btn = document.querySelector('.btn-toggle');
    btn.textContent = sidebar.classList.contains('minimizado') ? '▶' : '◀';
}

// TROCAR PÁGINAS
function mostrarPagina(nome){
    document.querySelectorAll('.pagina').forEach(p => p.classList.remove('ativa'));
    document.getElementById('pag-' + nome).classList.add('ativa');

    document.querySelectorAll('.menu a').forEach(a => a.classList.remove('ativo'));
    event.currentTarget.classList.add('ativo');

    mostrarTodos();
}

// FILTRAR DIAS
function filtrarDia(idDia){
    const paginaAtiva = document.querySelector('.pagina.ativa');
    const linhas = paginaAtiva.querySelectorAll('tbody tr');

    linhas.forEach(l => {
        l.style.display = (l.id === idDia) ? 'table-row' : 'none';
    });
}

function mostrarTodos(){
    document.querySelectorAll('tbody tr').forEach(l => l.style.display = 'table-row');
}

// PESQUISAR
function pesquisar(){
    const texto = document.getElementById("pesquisa").value.toLowerCase();
    const paginaAtiva = document.querySelector('.pagina.ativa');
    const linhas = paginaAtiva.querySelectorAll('tbody tr');

    linhas.forEach(linha => {
        linha.style.display = linha.innerText.toLowerCase().includes(texto) ? 'table-row' : 'none';
    });
}

// RELÓGIO E DATA
const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

function atualizarRelogio(){
    const agora = new Date();
    const mes = meses[agora.getMonth()];
    const ano = agora.getFullYear();
    const horas = agora.getHours().toString().padStart(2,'0');
    const minutos = agora.getMinutes().toString().padStart(2,'0');
    const segundos = agora.getSeconds().toString().padStart(2,'0');

    document.getElementById('relogio').innerHTML = `${horas}:${minutos}:${segundos}`;
    document.getElementById('relogio2').innerHTML = `${horas}:${minutos}:${segundos}`;
    document.getElementById('mesAtual').textContent = mes;
    document.getElementById('mesAtual2').textContent = mes;
    document.getElementById('anoAtual').textContent = ano;
    document.getElementById('anoAtual2').textContent = ano;
}

atualizarRelogio();
setInterval(atualizarRelogio, 1000);
</script>

</body>
</html>
